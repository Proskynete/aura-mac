<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Solo se usa al firmar con Developer ID (hardened runtime) en el workflow de release. -->
<dict>
    <!-- Cambiar el modo claro/oscuro de macOS a través de "Eventos del Sistema". -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
